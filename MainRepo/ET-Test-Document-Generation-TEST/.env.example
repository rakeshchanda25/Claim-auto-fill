# Copy to .env and adjust. Every variable below has a working default in code,
# so the app starts with none of them set - these only override.

# --- Agent model -------------------------------------------------------------
DOC_AGENT_MODEL=openai/qwen3.6:27b
DOC_AGENT_PROVIDER=litellm

# --- Agent sandbox -----------------------------------------------------------
# auto     - bubblewrap sandbox where the host supports it, else ephemeral_fs
# ephemeral_fs      - managed local workspace, no isolation (macOS/Windows)
# bubblewrap_process - real process isolation, Linux only
WORKSPACE_BACKEND=auto

# --- Guidewire ClaimCenter ---------------------------------------------------
# Optional. Without these, typing a claim number into the UI simply finds
# nothing and generation falls back to fully synthetic data.
GUIDEWIRE_BASE_URL=https://your-claimcenter-host:443
GUIDEWIRE_USERNAME=
GUIDEWIRE_PASSWORD=
GUIDEWIRE_TIMEOUT=60

# --- Server ------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8420
